# /etc/caddy/Caddyfile — Caddy сам получит и будет продлевать сертификат.
# <ИМЯ> — бесплатное имя вида <адрес-через-дефисы>.sslip.io или свой поддомен (sync.<домен>).
# При переезде на свой домен меняется только эта строка.
<ИМЯ> {
	encode gzip
	request_body {
		max_size 10MB
	}
	reverse_proxy 127.0.0.1:8787
}
